{
    "name": "pocket/pocket-api",
    "description": "Backend REST API for the Pocket application.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-redis": "*",
        "ext-intl": "*",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "var/www/html/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "vendor-dir": "var/www/vendor",
        "platform": {
            "php": "8.5.0",
            "ext-redis": "1",
            "ext-intl": "1",
            "ext-mysqli": "1",
            "ext-pdo_mysql": "1"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml.dist"
    }
}
